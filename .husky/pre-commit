#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# lint js and vue files
npx --no-install lint-staged

# lint only staged ruby files
# --no-run-if-empty: sem ele um commit sem nenhum .rb chama o rubocop sem argumentos, e ele
# varre o repositorio inteiro e falha nas offenses pre-existentes.
git diff --name-only --cached | xargs ls -1 2>/dev/null | grep '\.rb$' | xargs --no-run-if-empty bundle exec rubocop --force-exclusion

